# 监听：0.0.0.0 允许局域网访问，127.0.0.1 仅本机
AISHOW_HOST=0.0.0.0
AISHOW_PORT=9808
AISHOW_DB_PATH=./data/aishow.db
AISHOW_DATA_DIR=./data
# 推理边车回源地址，本机推理请保持 127.0.0.1
AISHOW_PUBLIC_BASE_URL=http://127.0.0.1:9808

# 开发前端直连后端时的额外 CORS 源（逗号分隔）。本机 5173 默认已放行。
# AISHOW_CORS_ORIGINS=http://192.168.1.10:5173
# 允许私网 IP 作为前端 Origin（局域网 Vite 开发）。仅本机可改 false。
AISHOW_CORS_LAN=true

# auto: 调用本机 SGLang。mock: 无 GPU 时完整演示队列。
AISHOW_INFERENCE_MODE=mock
AISHOW_SGLANG_FL2VA_URL=http://127.0.0.1:30010
AISHOW_SGLANG_REF2VA_URL=http://127.0.0.1:30011
AISHOW_MEDIA_FILE_PREFIX=file:///data/minimax-h3
AISHOW_URI_MODE=file
AISHOW_WORKER_CONCURRENCY=1
# 24GB 单卡：队列跨模型时自动停旧边车、再启新边车。关了就只跑已在线的引擎。
AISHOW_AUTO_SWITCH_ENGINE=true
# 同时最多加载几个推理边车。24GB 请保持 1。
AISHOW_MAX_LOADED_ENGINES=1
# 仓库根目录。留空则自动向上查找 scripts\start_h3_nf4.bat
# AISHOW_ROOT=
# AISHOW_COMFY_URL=http://127.0.0.1:8188

# 官方云端：H3-Context-IR 提示增强
AISHOW_MINIMAX_API_BASE=https://api.minimaxi.com
AISHOW_MINIMAX_API_TOKEN=

# 本机 FastH3（ComfyUI GGUF Q4 边车，默认 8000）
AISHOW_FASTH3_URL=http://127.0.0.1:8000

# 本机 H3 Turbo LoRA（DiffSynth NF4 + lightx2v 4 步，默认 30012）
AISHOW_H3_TURBO_URL=http://127.0.0.1:30012

# 本机 PinkCherry MiniMax-H3（独立 ComfyUI FL2VA，边车 30013 / Comfy 8189）
AISHOW_H3_PINKCHERRY_URL=http://127.0.0.1:30013
# AISHOW_PINKCHERRY_COMFY_URL=http://127.0.0.1:8189

# 本机 Timeline Director（SelfLift 二采，边车 30014 / Comfy 8188）
AISHOW_H3_DIRECTOR_URL=http://127.0.0.1:30014

# 本机 LLaDA-Image 文生图 / 指令编辑边车
AISHOW_LLADA_IMAGE_URL=http://127.0.0.1:30020

# 本机 Qwen-Image-2.1 文生图 / 指令编辑边车
AISHOW_QWEN_IMAGE_URL=http://127.0.0.1:30021

# 本地 Chat（OpenAI 兼容，默认 Ollama）。短剧写剧本 / 拆分镜 / 重写提示走这里，不是 H3 的 Qwen3-VL。
AISHOW_CHAT_URL=http://127.0.0.1:11434
AISHOW_CHAT_MODEL=qwen3.5:4b
# AISHOW_CHAT_API_TOKEN=

# 本地 TTS（OpenAI 兼容 /v1/audio/speech）。空则短剧合成不叠独立语音，仍用 H3 音轨。
# AISHOW_TTS_URL=http://127.0.0.1:8880
# AISHOW_TTS_MODEL=
# AISHOW_TTS_VOICE=alloy
# AISHOW_TTS_API_TOKEN=

# 账号：首次打开页面创建的账号即为管理员。也可在此预置。
# AISHOW_ADMIN_USER=admin
# AISHOW_ADMIN_PASSWORD=change-me
AISHOW_ALLOW_REGISTER=true
AISHOW_SESSION_DAYS=30
