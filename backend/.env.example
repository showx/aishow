AISHOW_PORT=9808
AISHOW_DB_PATH=./data/aishow.db
AISHOW_DATA_DIR=./data
AISHOW_PUBLIC_BASE_URL=http://127.0.0.1:9808

# auto: 调用本机 SGLang。mock: 无 GPU 时完整演示队列。
AISHOW_INFERENCE_MODE=mock
AISHOW_SGLANG_FL2VA_URL=http://127.0.0.1:30010
AISHOW_SGLANG_REF2VA_URL=http://127.0.0.1:30011
AISHOW_MEDIA_FILE_PREFIX=file:///data/minimax-h3
AISHOW_URI_MODE=file
AISHOW_WORKER_CONCURRENCY=1

# 官方云端：H3-Context-IR 提示增强
AISHOW_MINIMAX_API_BASE=https://api.minimaxi.com
AISHOW_MINIMAX_API_TOKEN=

# 本机 FastH3（FastVideo 蒸馏）
AISHOW_FASTH3_URL=http://127.0.0.1:8000

# 本机 LLaDA-Image 文生图 / 指令编辑边车
AISHOW_LLADA_IMAGE_URL=http://127.0.0.1:30020
